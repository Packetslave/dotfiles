export SNIPPETS_BACKUP="$HOME/Documents/SameBrain/Snippets/Backups"

function backup_snippets() {
  local FILE=all.md

  if [[ ! -d ${SNIPPETS_BACKUP} ]] ; then
    mkdir -p ${SNIPPETS_BACKUP}
  fi

  go run -C $HOME/src/snippets/cli . get --start 2000-01-01 > ${SNIPPETS_BACKUP}/${FILE}
}

