function gdcb() {
    if [[ "$(git_current_branch)" != "$(git_main_branch)" ]] ; then
        local b=$(git_current_branch)
        git checkout $(git_main_branch)
        git branch -D ${b}
    fi
}

unalias rg

unalias gdw
alias gdw="gd -w"
alias utc="date -z UTC"
alias buu="brew update && brew upgrade"

function git-rotate() { git branch -D $1 && gcb $1 ; }

t2 () {
  column -t
}

#
# Local config
#

if [[ -f $HOME/.zshrc.after ]] ; then
  . $HOME/.zshrc.after
fi


type atuin &> /dev/null && >&2 echo 🐚 atuin && eval "$(atuin init zsh --disable-up-arrow)"

type rbenv &> /dev/null && >&2 echo 🐚 rbenv && eval "$(rbenv init - --no-rehash zsh)"

type nvim &> /dev/null && alias vi=nvim && alias vim=nvim && alias nv=nvim

type nvim &> /dev/null && alias vi=nvim && alias vim=nvim && alias nv=nvim

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh --user-data-dir='.' --no-sandbox)"

alias stacked_rebase='cursor agent "the $(git_main_branch) branch has been squash-merged from one or more commits that exist on this branch. Pull the latest version of $(git_main_branch) from the remote, then rebase the current branch ($(git_current_branch)) on top of $(git_main_branch), taking this into account."'
alias nostack="jq 'del(.callstack)'"

unalias lg
alias lg="lazygit"
alias dickhouse="docker run --entrypoint clickhouse -it --rm clickhouse/clickhouse-server"

export LESS='-Ric -x4 --use-color -Dd+r$Du+b'
export MANROFFOPT='-c'

export NVM_DIR="$HOME/.nvm"
[ -s "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh" ] && >&2 echo 🐚 nvm && \. "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/nvm/nvm.sh"  # This loads nvm

# Added by LM Studio CLI (lms)
[ -d "$HOME/.lmstudio/bin" ] && export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section

# put local first so we get uv's python
export PATH=$HOME/.local/bin:$PATH
>&2 echo python3 is $(which python3)

# duti, PlistBuddy and iTerm2 are all macOS-only, as is vmd (it calls iterm)
if [[ "$OSTYPE" == darwin* ]] ; then
function set_default_app() {
  if [[ $# -lt 2 || $# -gt 3 ]]; then
    >&2 echo "usage: set_default_app <bundle-id> <extension-or-uti> [role]"
    >&2 echo "example: set_default_app com.microsoft.VSCode .json all"
    return 2
  fi

  local bundle_id=$1
  local filetype=$2
  local role=${3-all}

  duti -s "${bundle_id}" "${filetype}" "${role}"
}

function app_bundle_id() {
  if [[ $# -ne 1 ]]; then
    >&2 echo "usage: app_bundle_id <path-to-app>"
    >&2 echo "example: app_bundle_id /Applications/Visual\\ Studio\\ Code.app"
    return 2
  fi

  local app_path=${1%/}
  local info_plist="${app_path}/Contents/Info.plist"

  /usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "${info_plist}"
}

iterm() {
    local cmd="${1:-}"
    local size="${2:-80,24}"
    
    local cols="${size%%,*}"
    local rows="${size##*,}"

    osascript -e 'tell application "iTerm2"' \
              -e '  set newWin to (create window with default profile)' \
              -e '  tell current session of newWin' \
              -e "    set columns to $cols" \
              -e "    set rows to $rows" \
              -e "    write text \"cd '$(pwd)' ${cmd:+&& $cmd}\"" \
              -e '  end tell' \
              -e 'end tell'
}

function vmd() {
  iterm "glow -p $1 -w 0" 160,48
}
fi

export DRONE_SERVER=https://drone.build.ue1.snooguts.net
export SRC_ENDPOINT=https://reddit.sourcegraphcloud.com
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

claude() {
  # One sops decrypt = one Touch ID prompt; MCP servers inherit the env
  # (regen the file with secrets/build-claude-startup.sh after editing secrets)
  # sops locates age-plugin-se via $PATH, so pin homebrew for non-interactive SSH
  local brew_bin="${HOMEBREW_PREFIX:-/opt/homebrew}/bin"
  local secrets="$HOME/src/cowork/secrets/claude-startup.enc.env"
  local claude_bin sops_bin
  # whence -p, not command -v: inside this function the latter resolves to the
  # function itself. The brew path wins; the PATH search covers a host carrying
  # a native install instead (seaside).
  claude_bin="$brew_bin/claude" ; [[ -x "$claude_bin" ]] || claude_bin="$(whence -p claude)"
  sops_bin="$brew_bin/sops"     ; [[ -x "$sops_bin"   ]] || sops_bin="$(whence -p sops)"

  if [[ -z "$claude_bin" ]] ; then
    >&2 echo "claude: not installed — brew install --cask claude-code"
    return 127
  fi
  # Degrade instead of failing when the machine has no sops identity yet.
  # Without this the wrapper makes claude unlaunchable rather than merely
  # credential-less, which is the state of every host before enrollment.
  if [[ -z "$sops_bin" || ! -f "$secrets" ]] ; then
    >&2 echo "claude: no sops secrets — MCP servers start without credentials"
    "$claude_bin" --enable-auto-mode "$@"
    return
  fi
  PATH="$brew_bin:$PATH" "$sops_bin" exec-env "$secrets" \
    "$claude_bin --enable-auto-mode ${(j: :)${(q)@}}"
}

alias p8='sudo mtr -z 8.8.8.8'
alias crg='rg --color=always'
alias cbat='bat --color=always'
alias codex='echo WARNING - using stdio MCP wrapper script >&2; $HOME/src/SameBrain/Scripts/codex-mcp-stdio'
