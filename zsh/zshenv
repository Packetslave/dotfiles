#!/usr/bin/env zsh
# shellcheck shell=bash disable=SC2034,SC1091

# zsh reads this file for *every* shell, including the non-interactive one that
# `ssh host <command>` spawns — zshrc is interactive-only. Without it a remote
# command sees just the bare PATH sshd hands out (/usr/bin:/bin:/usr/sbin:/sbin
# on macOS), so anything installed by Homebrew is invisible. That is why
# `mosh lunchbox` could not find mosh-server without --server=, and why the
# claude() wrapper in zshrc has to pin the brew prefix by hand.

# The brew loop below also runs in zshrc, which is not redundant: on macOS
# /etc/zprofile runs path_helper *after* this file and demotes Homebrew below
# /usr/bin for login shells, so zshrc's re-run is what restores precedence.
# Tying path/PATH as unique keeps that second pass from stacking duplicates.
typeset -U path PATH

# shellenv costs ~11ms (a fork), and it exports HOMEBREW_PREFIX — so gate on it
# and child shells inherit the environment instead of paying again.
if [[ -z "$HOMEBREW_PREFIX" ]] ; then
  for _brew in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew ; do
    if [ -x "$_brew" ] ; then
      eval "$("$_brew" shellenv)"
      break
    fi
  done
  unset _brew
fi

# libpq is keg-only, so brew links none of it: psql, pg_dump and friends exist
# under $HOMEBREW_PREFIX/opt/libpq/bin and nowhere else. Here rather than in
# zshrc because the case that wants it most is non-interactive — an operator
# reaching a firewalled managed database over `ssh -L` and running one query
# from a script sees zshenv's PATH and never zshrc's.
#
# Guarded on the directory: the formula is not installed everywhere yet, and an
# unconditional prepend would put a missing path in front of every lookup.
if [[ -n "$HOMEBREW_PREFIX" && -d "$HOMEBREW_PREFIX/opt/libpq/bin" ]] ; then
  path=("$HOMEBREW_PREFIX/opt/libpq/bin" $path)
fi

# bd (beads) resolves its workspace by walking up from the cwd. The projects
# under ~/src/cowork/src -- chassis, homelab, gmail-duckdb, matrix -- are
# separate git repos with no .beads of their own, so the walk stops at their
# root and bd fails with "no beads database found", suggesting `bd init`, which
# would be actively wrong: it would create a second database inside the nested
# repo. cowork's is authoritative for all of them.
#
# Here rather than in zshrc for the usual reason: the shells that hit this are
# non-interactive -- an agent's tool call, a hook, `ssh host bd ...`, a cron
# job -- and those never read zshrc. Guarded on the directory so a machine
# without the checkout is left alone; a bd invocation that genuinely wants a
# different workspace can still override with `bd -C <path>` or its own
# BEADS_DIR.
if [[ -d "$HOME/src/cowork/.beads" ]] ; then
  export BEADS_DIR="$HOME/src/cowork/.beads"
fi

# studio kept this in a hand-written ~/.zshenv that this file now replaces, and
# it is the only machine with a Rust toolchain. It belongs here on the merits
# anyway: cargo's env script only prepends ~/.cargo/bin to PATH, which is
# exactly the job of this file. The script guards against double-prepending and
# prints nothing, so it is safe for the non-interactive case above.
# An if block rather than `[[ ... ]] && ...`: as the last line of the file the
# && form would leave a non-zero $? in every shell that has no cargo.
if [[ -f "$HOME/.cargo/env" ]] ; then
  . "$HOME/.cargo/env"
fi
